# ==============================================================
# Indian Equity & IPO Portfolio Analyzer - Environment Config
# ==============================================================

# Server Port
PORT=5000

# Application Environment ('development' or 'production')
NODE_ENV=development

# JWT Secret for session signing and authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# ==============================================================
# Database Configuration (@libsql/client / Turso & SQLite)
# ==============================================================
# For Local Development (defaults to local file:data/portfolio.db if empty):
# DB_PATH=file:data/portfolio.db

# For Turso Cloud SQLite (Production):
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-database-auth-token

# ==============================================================
# Client / Frontend API Target (Vite client)
# ==============================================================
# Leave unset or empty when running with reverse proxy or unified server (/api)
# VITE_API_URL=http://localhost:5000/api
